# ARGUS configuration. Every section below is optional — the server boots
# fine with only EPICS configured; every other provider reports itself as
# "unconfigured" (not an error) until its variables are set.

# --- Server ---
ARGUS_TRANSPORT=stdio          # stdio | sse
ARGUS_SSE_HOST=127.0.0.1
ARGUS_SSE_PORT=8000
ARGUS_LOG_LEVEL=INFO
ARGUS_LOG_JSON=true            # false for a readable console renderer in local dev

# --- EPICS (Channel Access + pvAccess) ---
EPICS_CA_ADDR_LIST=
EPICS_CA_AUTO_ADDR_LIST=YES
EPICS_PVA_ADDR_LIST=

# --- Archiver Appliance ---
ARCHIVER_BASE_URL=

# --- ChannelFinder (device/PV metadata registry, the Device source of truth) ---
CHANNELFINDER_BASE_URL=
CHANNELFINDER_USERNAME=
CHANNELFINDER_PASSWORD=

# --- Kubernetes ---
KUBECONFIG=
K8S_NAMESPACE_DEFAULT=default
K8S_IOC_LABEL_SELECTOR_TEMPLATE=app=ioc,device={ioc_name}

# --- ArgoCD ---
ARGOCD_SERVER_URL=
ARGOCD_AUTH_TOKEN=

# --- Logbook (olog-compatible) ---
LOGBOOK_BASE_URL=
LOGBOOK_USERNAME=
LOGBOOK_PASSWORD=

# --- Elasticsearch ---
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_DEFAULT_INDEX=argus-logs

# --- Documentation search (local TF-IDF over a docs folder) ---
DOCS_PATH=
DOCS_INDEX_PATH=

# --- Caching ---
CACHE_DEVICE_TTL_SECONDS=300
CACHE_CHANNELFINDER_TTL_SECONDS=120
CACHE_KUBERNETES_TTL_SECONDS=30
